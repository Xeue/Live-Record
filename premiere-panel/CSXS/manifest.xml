<?xml version="1.0" encoding="UTF-8"?>
<!--
  Live Record — Growing File Refresh.

  A test bench for making Premiere re-read a growing clip without the
  alt-tab gesture. Premiere has no "run a script" menu, so a CEP panel is the
  practical way to execute ExtendScript against the running application.

  CSXS 12 with a wide PPRO range: Premiere 26.2 ships CEP panels built against
  CSXS 12 / host 25.5, so this matches what the host already loads.

  Unsigned, for in-house use. That requires PlayerDebugMode, which install.sh
  sets — Premiere will not load an unsigned extension otherwise.
-->
<ExtensionManifest Version="12.0" ExtensionBundleId="tv.chilton.liverecord.refresh"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Live Record Refresh"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="tv.chilton.liverecord.refresh.panel" Version="1.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="tv.chilton.liverecord.refresh.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node is what lets the panel create the hardlink the
                 changeMediaPath technique needs. Without it require('fs')
                 throws and that whole route is unavailable. -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Live Record Refresh</Menu>
          <Geometry>
            <Size><Height>560</Height><Width>420</Width></Size>
            <MinSize><Height>320</Height><Width>320</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
